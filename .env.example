# 企业微信邮箱 / 腾讯企业邮箱配置
# 完整企业邮箱地址，如：username@yourcompany.com
EXMAIL_USER=your_email@company.com

# 客户端专用密码（网页端设置->邮箱绑定->生成客户端专用密码）
EXMAIL_PASS=your_client_app_password

# 发送服务器配置（默认可留空，使用官方默认值）
EXMAIL_SMTP_HOST=smtp.exmail.qq.com
EXMAIL_SMTP_PORT=465

# 接收服务器配置（默认可留空，使用官方默认值）
EXMAIL_IMAP_HOST=imap.exmail.qq.com
EXMAIL_IMAP_PORT=993
